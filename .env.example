# Pédiluve — environment variables
# Copy this to backend/.env (all vars) and to frontend/.env (only the VITE_
# ones are read there) and fill in your values. Never commit .env.

# ── ElevenLabs ──────────────────────────────────────────────
# Get your key at https://elevenlabs.io → Profile → API Keys. Keys can be
# permission-scoped: enable both "Speech to Text" (live transcription) and
# "Text to Speech" (Phase 5 playback) on it, or TTS requests are rejected.
ELEVENLABS_API_KEY=

# Voice ID for TTS (Phase 5 - play a translated line back, owner and QR
# viewers alike). Required for that feature; the rest of the app works
# without it. One fixed voice for v1, not one per language.
# On the free plan, pick one of ElevenLabs' default voices - a Voice Library
# voice returns 402 "paid_plan_required" when used through the API.
ELEVENLABS_VOICE_ID=

# ── DeepL ───────────────────────────────────────────────────
# Free tier key at https://www.deepl.com/pro-api (ends with ":fx")
DEEPL_API_KEY=

# ── Supabase ────────────────────────────────────────────────
# Project Settings → API
SUPABASE_URL=
# Always the "anon" public key - never the service-role key. From Phase 3 on,
# the backend attaches each signed-in user's own JWT per request
# (services/supabase.py::client_for) so Row Level Security enforces who can
# see what; the service-role key bypasses RLS entirely and must not be used
# here.
SUPABASE_KEY=

# ── Backend ─────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# Add your machine's LAN origin (e.g. http://192.168.1.42:5173) alongside
# localhost when demoing the QR live viewer (KAN-50) so a phone on the same
# Wi-Fi, opening the share link at that LAN address, isn't blocked by CORS.
CORS_ORIGINS=http://localhost:5173

# ── Frontend (goes in frontend/.env, prefixed VITE_) ────────
# Same project as SUPABASE_URL/SUPABASE_KEY above, but the anon key here is
# read directly by the browser (supabase-js) - still never the service-role
# key; the browser client only ever acts as the signed-in user via RLS.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# VITE_WS_URL=ws://localhost:8000/ws

# Base URL for the REST API (lib/api.ts's getApiUrl) - the same backend the
# WebSocket above connects to, just http(s) instead of ws(s).
# VITE_API_URL=http://localhost:8000

# How often (ms) the browser flushes buffered PCM audio to the WebSocket.
# Lower = lower latency but more/smaller WS messages. Default in code: 250.
# VITE_CHUNK_DURATION_MS=250

# The QR code / share link's base URL (lib/share.ts's buildShareUrl). The
# mic (getUserMedia) only works in a secure context - exactly "localhost"
# or https - so the owner has to keep recording at http://localhost:5173,
# but a QR code built from that page's own origin would then say
# "localhost" to the phone scanning it, which means the phone itself, not
# your machine. Set this to your machine's LAN origin when demoing the QR
# live viewer (KAN-50) so the owner stays on localhost (mic works) while
# the QR/share link still points somewhere the phone can actually reach.
# VITE_SHARE_BASE_URL=http://192.168.1.42:5173
