# Pédiluve — environment variables
# Copy this to backend/.env and fill in your values. Never commit .env.

# ── ElevenLabs ──────────────────────────────────────────────
# Get your key at https://elevenlabs.io → Profile → API Keys
ELEVENLABS_API_KEY=

# Voice ID for TTS (Phase 4). Leave empty until then.
# Browse voices at https://elevenlabs.io/voice-library
ELEVENLABS_VOICE_ID=

# ── DeepL ───────────────────────────────────────────────────
# Free tier key at https://www.deepl.com/pro-api (ends with ":fx")
DEEPL_API_KEY=

# ── Supabase ────────────────────────────────────────────────
# Project Settings → API
SUPABASE_URL=
SUPABASE_KEY=          # use the "anon" public key for now

# ── Backend ─────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173

# Audio chunk length sent from browser, in milliseconds
CHUNK_DURATION_MS=2000

# ── Frontend (goes in frontend/.env, prefixed VITE_) ────────
# VITE_WS_URL=ws://localhost:8000/ws
