# Pédiluve — environment variables
# Copy this to backend/.env and fill in your values. Never commit .env.

# ── ElevenLabs ──────────────────────────────────────────────
# Get your key at https://elevenlabs.io → Profile → API Keys
ELEVENLABS_API_KEY=

# Voice ID for TTS (Phase 5). Leave empty until then.
# Browse voices at https://elevenlabs.io/voice-library
ELEVENLABS_VOICE_ID=

# ── DeepL ───────────────────────────────────────────────────
# Free tier key at https://www.deepl.com/pro-api (ends with ":fx")
DEEPL_API_KEY=

# ── Supabase ────────────────────────────────────────────────
# Project Settings → API
SUPABASE_URL=
# Always the "anon" public key - never the service-role key. From Phase 3 on,
# the backend attaches each signed-in user's own JWT per request
# (services/supabase.py::client_for) so Row Level Security enforces who can
# see what; the service-role key bypasses RLS entirely and must not be used
# here.
SUPABASE_KEY=

# ── Backend ─────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173

# ── Frontend (goes in frontend/.env, prefixed VITE_) ────────
# VITE_WS_URL=ws://localhost:8000/ws

# How often (ms) the browser flushes buffered PCM audio to the WebSocket.
# Lower = lower latency but more/smaller WS messages. Default in code: 250.
# VITE_CHUNK_DURATION_MS=250
